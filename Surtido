// ─── BARCODE MODAL ────────────────────────────────────────────────
function BarcodeModal({ product, onClose, onAssign }) {
  const hasBC = product.barcode && !product.barcode.startsWith("AUTO");
  const [code, setCode]       = useState(hasBC ? product.barcode : generateCode(product));
  const [assigned, setAssigned] = useState(false);

  return (
    <div className="mo" onClick={onClose}>
      <div className="mp" onClick={e=>e.stopPropagation()}>
        <div className="mt">{product.name}</div>
        <div className="msub">CODE 128 · Surtido Barcode System</div>

        {!hasBC && !assigned && (
          <div className="bc-warn">
            ⚠ Este producto no tiene código de barras. Genera uno o ingrésalo manualmente.
          </div>
        )}

        <div className="bc-input-row">
          <input className="bc-input" value={code}
            onChange={e=>setCode(e.target.value.toUpperCase().replace(/[^A-Z0-9\-]/g,""))}
            placeholder="CÓDIGO"
          />
          {!hasBC && (
            <button className="bc-auto" onClick={()=>setCode(generateCode(product))}>AUTO</button>
          )}
        </div>

        <div className="bc-preview">
          {code ? <BarcodeDisplay value={code} height={70}/> :
            <span style={{fontFamily:"'Share Tech Mono',monospace",fontSize:"0.5rem",color:"#4a5040"}}>Ingresa un código arriba</span>
          }
        </div>

        <div className="bc-actions">
          {!assigned && (
            <button className="bc-assign" onClick={()=>{onAssign(product.id, code);setAssigned(true);}}>
              ✓ ASIGNAR CÓDIGO
            </button>
          )}
          {assigned && <div className="bc-success">✓ Código asignado y guardado</div>}
          <button className="bc-close" onClick={onClose}>CERRAR</button>
        </div>
      </div>
    </div>
  );
}

