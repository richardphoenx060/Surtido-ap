function FileImporter({ onClose, onImport }) {
  const [fileName,   setFileName]   = useState(null);
  const [previewRows,setPreviewRows]= useState([]);
  const [mode,       setMode]       = useState("replace");
  const [dragOver,   setDragOver]   = useState(false);

  const handleFile = (file) => {
    setFileName(file.name);
    setPreviewRows([
      {name:"Camisa Polo Azul M",   qty:18, cost:"$8.50"},
      {name:"Pantalón Slim Negro",  qty:12, cost:"$22.00"},
      {name:"Vestido Verano Blanco",qty:8,  cost:"$30.00"},
    ]);
  };

  return (
    <div className="mo" onClick={onClose}>
      <div className="mp" style={{maxWidth:"520px"}} onClick={e=>e.stopPropagation()}>
        <div className="mt">IMPORTAR INVENTARIO</div>
        <div className="msub">Selecciona tu archivo .xlsx, .xls o .csv.</div>

        {!fileName ? (
          <div className={`imp-drop ${dragOver?"over":""}`}
            onDragOver={e=>{e.preventDefault();setDragOver(true);}}
            onDragLeave={()=>setDragOver(false)}
            onDrop={e=>{e.preventDefault();setDragOver(false);if(e.dataTransfer.files[0])handleFile(e.dataTransfer.files[0]);}}>
            <input type="file" accept=".xlsx,.xls,.csv"
              onChange={e=>{if(e.target.files[0])handleFile(e.target.files[0]);}}/>
            <div className="imp-icon">📂</div>
            <span className="imp-lbl">SELECCIONAR ARCHIVO</span>
            <span className="imp-sub">.xlsx · .xls · .csv — o arrastra y suelta aquí</span>
          </div>
        ) : (
          <>
            <div className="imp-file">
              <span>📄 {fileName}</span>
              <span style={{color:"#90c878"}}>{previewRows.length} filas encontradas</span>
            </div>

            <div style={{fontFamily:"'Share Tech Mono',monospace",fontSize:"0.52rem",color:"#4a5040",letterSpacing:"0.18em",marginBottom:"0.4rem"}}>MODO DE IMPORTACIÓN</div>
            <div className="imp-mode">
              <button className={`imp-mb ${mode==="replace"?"on":""}`} onClick={()=>setMode("replace")}>⟳ REEMPLAZAR</button>
              <button className={`imp-mb ${mode==="merge"?"on":""}`}   onClick={()=>setMode("merge")}>+ COMBINAR</button>
            </div>

            <div style={{fontFamily:"'Share Tech Mono',monospace",fontSize:"0.52rem",color:"#4a5040",letterSpacing:"0.18em",marginBottom:"0.4rem"}}>VISTA PREVIA</div>
            <div className="imp-prev">
              <div className="imp-prow hdr"><span>NOMBRE</span><span>CANT.</span><span>COSTO</span></div>
              {previewRows.map((r,i)=>(
                <div key={i} className="imp-prow">
                  <span className="imp-pname">{r.name}</span>
                  <span>{r.qty}</span>
                  <span>{r.cost}</span>
                </div>
              ))}
            </div>
          </>
        )}

        <div className="imp-acts">
          {fileName && (
            <button className="imp-confirm" onClick={()=>{onImport(previewRows.length);onClose();}}>
              IMPORTAR TODO ({previewRows.length})
            </button>
          )}
          <button className="imp-cancel" onClick={onClose}>CANCELAR</button>
        </div>
      </div>
    </div>
  );
}

// ─── OFFLINE SYNC ─────────────────────────────────────────────────
function OfflineSync({ products }) {
  const [mode,    setMode]    = useState("lan");
  const [ip,      setIp]      = useState("192.168.1.");
  const [port,    setPort]    = useState("3001");
  const [status,  setStatus]  = useState(null);
  const [syncing, setSyncing] = useState(false);
  const [lastSync,setLastSync]= useState(null);

  const simulateSync = async () => {
    setSyncing(true);
    setStatus({type:"info", msg:"🔌 Conectando a " + ip + ":" + port + "..."});
    await new Promise(r=>setTimeout(r,1200));
    setStatus({type:"info", msg:"📤 Enviando " + products.length + " productos..."});
    await new Promise(r=>setTimeout(r,1000));
    setLastSync(new Date().toLocaleString());
    setStatus({type:"ok", msg:`✓ ${products.length} productos sincronizados exitosamente.`});
    setSyncing(false);
  };

  const exportJSON = () => {
    const data = JSON.stringify({storeName: CONFIG.storeName, exportedAt:new Date().toISOString(), products}, null, 2);
    const blob  = new Blob([data], {type:"application/json"});
    const url   = URL.createObjectURL(blob);
    const a     = document.createElement("a"); a.href=url;
    a.download  = `surtido-${todayKey()}.json`;
    a.click(); URL.revokeObjectURL(url);
    setStatus({type:"ok", msg:"✓ Archivo JSON descargado exitosamente."});
  };

  const exportCSV = () => {
    const headers = ["barcode","name","category","quantity","unitCost","batchId","rackLocation"];
    const rows = products.map(p=>headers.map(h=>`"${String(p[h]||"").replace(/"/g,'""')}"`).join(","));
    const csv  = [headers.join(","),...rows].join("\n");
    const blob = new Blob([csv],{type:"text/csv"});
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement("a"); a.href=url;
    a.download = `surtido-${todayKey()}.csv`;
    a.click(); URL.revokeObjectURL(url);
    setStatus({type:"ok", msg:"✓ Archivo CSV descargado exitosamente."});
  };

  return (
    <div className="osync">
      <div className="osync-modes">
        {[["lan","📡 LAN / Wi-Fi"],["bt","🔵 Bluetooth"],["usb","🔌 USB / Exportar"]].map(([m,lbl])=>(
          <button key={m} className={`osync-mode ${mode===m?"on":""}`} onClick={()=>{setMode(m);setStatus(null);}}>
            {lbl}
          </button>
        ))}
      </div>

      {status && <div className={`osync-status ${status.type}`}>{status.msg}</div>}

      {mode==="lan" && (
        <div className="osync-panel">
          <div className="osync-desc">
            💡 Asegúrate de que tus dispositivos estén en la misma red Wi-Fi.<br/>
            Ejecuta en tu PC: <strong>npx surtido-receiver --port 3001</strong>
          </div>
          <div className="osync-row">
            <div className="osync-fl">
              <span className="osync-lbl">IP DE LA COMPUTADORA</span>
              <input className="osync-inp" value={ip} onChange={e=>setIp(e.target.value)} placeholder="192.168.1.100"/>
            </div>
            <div className="osync-fl">
              <span className="osync-lbl">PUERTO</span>
              <input className="osync-inp" value={port} onChange={e=>setPort(e.target.value)}/>
            </div>
          </div>
          <button className="osync-btn" disabled={syncing} onClick={simulateSync}>
            {syncing ? "ENVIANDO DATOS..." : "CONECTAR Y SINCRONIZAR"}
          </button>
        </div>
      )}

      {mode==="bt" && (
        <div className="osync-panel">
          <div className="osync-desc">Asegúrate de que el Bluetooth esté activo en ambos dispositivos emparejados.</div>
          <button className="osync-btn" onClick={async()=>{
            setStatus({type:"info",msg:"🔵 Buscando dispositivos Bluetooth cercanos..."});
            await new Promise(r=>setTimeout(r,1500));
            setStatus({type:"info",msg:"Dispositivo listo para sincronizar por RFCOMM."});
          }}>
            🔵 BUSCAR DISPOSITIVOS
          </button>
        </div>
      )}

      {mode==="usb" && (
        <div className="osync-panel">
          <div className="osync-desc">Exporta el inventario para transferirlo por cable USB o almacenamiento externo.</div>
          <div className="osync-export">
            <button className="osync-ebtn" onClick={exportJSON}>⬇ EXPORTAR JSON</button>
            <button className="osync-ebtn" onClick={exportCSV}>⬇ EXPORTAR CSV</button>
          </div>
        </div>
      )}

      <div className="osync-statbox">
        <div className="osync-stit">ESTADO DE SINCRONÍA</div>
        <div className="osync-srow"><span className="osync-slbl">ÚLTIMA SINCRONÍA</span><span className="osync-sval">{lastSync||"Nunca"}</span></div>
        <div className="osync-srow"><span className="osync-slbl">PRODUCTOS</span><span className="osync-sval" style={{color:"#c8a84b"}}>{products.length}</span></div>
        <div className="osync-srow"><span className="osync-slbl">VALOR TOTAL</span><span className="osync-sval" style={{color:"#c8a84b"}}>${products.reduce((s,p)=>s+p.quantity*p.unitCost,0).toFixed(2)}</span></div>
      </div>
    </div>
  );
}

