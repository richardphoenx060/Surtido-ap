// ─── JSBARCODE LOADER ────────────────────────────────────────────
let _jsBarcodeReady = false;
const loadJsBarcode = () => new Promise((resolve, reject) => {
  if (window.JsBarcode) { resolve(window.JsBarcode); return; }
  if (_jsBarcodeReady) {
    const check = setInterval(() => {
      if (window.JsBarcode) { clearInterval(check); resolve(window.JsBarcode); }
    }, 50);
    setTimeout(() => { clearInterval(check); reject(new Error("timeout")); }, 6000);
    return;
  }
  _jsBarcodeReady = true;
  const s = document.createElement("script");
  s.src = "https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js";
  s.onload  = () => resolve(window.JsBarcode);
  s.onerror = () => reject(new Error("CDN failed"));
  document.head.appendChild(s);
});

// ─── BARCODE DISPLAY ─────────────────────────────────────────────
function BarcodeDisplay({ value, height = 70 }) {
  const ref   = useRef(null);
  const [ok,  setOk]  = useState(false);
  const [err, setErr] = useState(null);

  useEffect(() => {
    if (!value) return;
    let cancelled = false;
    loadJsBarcode().then(JsBarcode => {
      if (cancelled || !ref.current) return;
      try {
        JsBarcode(ref.current, value, {
          format: "CODE128", width: 2, height,
          displayValue: true, font: "Courier New", fontSize: 13,
          textMargin: 4, margin: 8,
          background: "#0d0f0b", lineColor: "#d4d8c8",
        });
        setOk(true);
      } catch(e) { setErr(e.message); }
    }).catch(e => { if (!cancelled) setErr(e.message); });
    return () => { cancelled = true; };
  }, [value, height]);

  if (err) return <div style={{fontFamily:"'Share Tech Mono',monospace",fontSize:"0.5rem",color:"#e05050",padding:"8px"}}>✗ {err}</div>;
  return <svg ref={ref} style={{maxWidth:"100%",opacity:ok?1:0,transition:"opacity 0.2s"}}/>;
}

const generateCode = (p) => p.barcode && !p.barcode.startsWith("AUTO")
  ? p.barcode
  : `SRT${String(p.id).padStart(8,"0")}`;

